{
  "name": "blobs-guru-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "NODE_OPTIONS='--inspect' next dev --experimental-https",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "lint-staged",
    "lint:next": "eslint .",
    "prepare": "husky",
    "check-types": "tsc --noEmit --pretty",
    "commit": "cz"
  },
  "dependencies": {
    "@apollo/client": "^3.11.8",
    "@lottiefiles/dotlottie-react": "^0.9.3",
    "@tanstack/react-query": "^5.59.0",
    "avail-js-sdk": "^0.3.0",
    "axios": "^1.7.7",
    "bignumber.js": "^9.1.2",
    "clsx": "^2.1.1",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "framer-motion": "^11.11.1",
    "graphql": "^16.9.0",
    "lodash": "^4.17.21",
    "lottie-react": "^2.4.0",
    "lucide-react": "^0.447.0",
    "motion-number": "^0.1.7",
    "next": "16.3.0",
    "next-themes": "^0.3.0",
    "react": "^18",
    "react-dom": "^18",
    "react-icons": "^5.4.0",
    "react-tooltip": "^5.28.0",
    "react-use": "^17.5.1",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.3",
    "viem": "2.x",
    "wagmi": "^2.12.17"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.1",
    "@commitlint/config-conventional": "^19.4.1",
    "@commitlint/cz-commitlint": "^19.4.0",
    "@opennextjs/cloudflare": "1.20.2",
    "@types/lodash": "^4.17.7",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "commitizen": "^4.3.0",
    "daisyui": "^4.12.12",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "husky": "^9.1.5",
    "lint-staged": "^15.2.10",
    "postcss": "^8",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "wrangler": "4.120.0"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
