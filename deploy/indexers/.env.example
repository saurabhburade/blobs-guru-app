# Copy this file to .env on the VPS. Keep .env out of Git.
REPO_DIR=/root/blobs-guru-app
ETH_DB_USER=postgres
CELESTIA_DB_USER=celestia_indexer
AVAIL_DB_USER=avail_indexer
ETH_DB_PASSWORD=copy-from-existing-ethereum-postgres-env
CELESTIA_DB_PASSWORD=replace-with-a-random-secret
AVAIL_DB_PASSWORD=replace-with-a-different-random-secret

ETH_RPC_ENDPOINTS=https://eth.drpc.org
CELESTIA_RPC_ENDPOINTS=https://public-endpoint.celestia-mainnet.quiknode.pro
AVAIL_RPC_ENDPOINTS=wss://mainnet-rpc.avail.so/ws
ETH_PRICE_FEED_ARCHIVE_BASE_URL=https://raw.githubusercontent.com/saurabhburade/blobs-guru-app/refs/heads/main/apps/ethereum-subquery/src/mappings/pricefeed/saveddata
CELESTIA_PRICE_FEED_ARCHIVE_BASE_URL=https://raw.githubusercontent.com/saurabhburade/blobs-guru-app/refs/heads/main/apps/celestia-subquery/src/mappings/pricefeed/saveddata
AVAIL_PRICE_FEED_ARCHIVE_BASE_URL=https://raw.githubusercontent.com/saurabhburade/blobs-guru-app/refs/heads/main/apps/avail-subquery/src/mappings/pricefeed/saved
BINANCE_API_BASE_URL=https://api.binance.com
REDSTONE_API_BASE_URL=https://api.redstone.finance
COINGECKO_API_BASE_URL=https://api.coingecko.com
ETH_PRICE_RPC_URL=https://eth.drpc.org
DEX_GURU_API_BASE_URL=https://api.dev.dex.guru
DEFILLAMA_API_BASE_URL=https://coins.llama.fi
ETHERSCAN_API_BASE_URL=https://api.etherscan.io
DEX_GURU_API_KEY=
ETHERSCAN_API_KEY=
