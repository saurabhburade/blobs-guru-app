{
  "name": "blobs-guru",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "pnpm --filter @blobs-guru/web dev",
    "dev:web": "pnpm --filter @blobs-guru/web dev",
    "dev:indexer:ethereum": "pnpm --filter @blobs-guru/indexer-ethereum dev",
    "dev:indexer:avail": "pnpm --filter @blobs-guru/indexer-avail dev",
    "dev:indexer:celestia": "pnpm --filter @blobs-guru/indexer-celestia dev",
    "build": "pnpm --recursive --if-present build",
    "build:web": "pnpm --filter @blobs-guru/web build",
    "build:indexers": "pnpm --filter '@blobs-guru/indexer-*' --recursive build",
    "codegen:indexers": "pnpm --filter '@blobs-guru/indexer-*' --parallel codegen",
    "test:indexers": "pnpm --filter '@blobs-guru/indexer-*' --recursive test",
    "check-types": "pnpm --filter @blobs-guru/web check-types",
    "lint": "lint-staged",
    "lint:web": "pnpm --filter @blobs-guru/web lint",
    "prepare": "husky",
    "commit": "cz"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.1",
    "@commitlint/config-conventional": "^19.4.1",
    "@commitlint/cz-commitlint": "^19.4.0",
    "commitizen": "^4.3.0",
    "husky": "^9.1.5",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
