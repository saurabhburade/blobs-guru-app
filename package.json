{
  "name": "blobs-guru",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev": "turbo run dev --filter=@blobs-guru/web",
    "dev:web": "turbo run dev --filter=@blobs-guru/web",
    "dev:ethereum-subquery": "turbo run dev --filter=@blobs-guru/ethereum-subquery",
    "dev:avail-subquery": "turbo run dev --filter=@blobs-guru/avail-subquery",
    "dev:celestia-subquery": "turbo run dev --filter=@blobs-guru/celestia-subquery",
    "build": "turbo run build --filter=@blobs-guru/web --filter='@blobs-guru/*-subquery'",
    "build:web": "turbo run build --filter=@blobs-guru/web",
    "build:subqueries": "turbo run build --filter='@blobs-guru/*-subquery'",
    "build:substream-eth-blobs": "turbo run build --filter=@blobs-guru/substream-eth-blobs",
    "codegen:subqueries": "turbo run codegen --filter='@blobs-guru/*-subquery'",
    "codegen:substream-eth-blobs": "turbo run codegen --filter=@blobs-guru/substream-eth-blobs",
    "test:subqueries": "turbo run test --filter='@blobs-guru/*-subquery'",
    "check-types": "turbo run check-types --filter=@blobs-guru/web",
    "check:biome": "biome check *.json apps/*/package.json *.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "lint-staged",
    "lint:web": "pnpm --filter @blobs-guru/web lint",
    "prepare": "husky",
    "commit": "cz"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@commitlint/cli": "^19.4.1",
    "@commitlint/config-conventional": "^19.4.1",
    "@commitlint/cz-commitlint": "^19.4.0",
    "commitizen": "^4.3.0",
    "husky": "^9.1.5",
    "lint-staged": "^15.2.10",
    "turbo": "2.10.12"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  }
}
